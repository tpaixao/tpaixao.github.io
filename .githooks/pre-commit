#!/usr/bin/env bash
# No-op. Previously this hook jupytext-synced every staged blog/*.qmd+*.ipynb
# pair. That pairing was retired on 2026-10-08 (commit 3ec02ae): notebooks are
# now the single source of truth, qmd twins were deleted, and all jupytext
# pairing metadata was stripped. Kept as an executable no-op so clones that set
# `git config core.hooksPath .githooks` do not fail on a missing hook.
# If no other hook logic returns here, you can instead clean up completely with:
#   git config --unset core.hooksPath
set -euo pipefail
exit 0